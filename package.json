{
  "name": "second-look",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "smoke:akta": "tsx scripts/akta-smoke.ts",
    "setup": "tsx scripts/setup.ts",
    "doctor": "tsx scripts/setup.ts --check",
    "demo": "concurrently -k -n api,web \"tsx server/index.ts --demo\" \"npm:dev:web\"",
    "capture:demo": "tsx scripts/capture-demo.ts",
    "start": "node --import tsx server/index.ts",
    "mcp": "node --import tsx scripts/mcp.ts",
    "connect:agent": "node --import tsx scripts/connect-agent.ts",
    "demo:comparison": "concurrently -k -n api,web \"tsx server/index.ts --demo --comparison\" \"npm:dev:web\""
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@roundtable/sdk": "https://github.com/roundtable-bot/roundtable-cli/releases/download/sdk-v0.1.1/roundtable-sdk-0.1.1.tgz",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
