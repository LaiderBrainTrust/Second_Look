# Copy to .env.local; Node loads it on startup. Exported values take precedence.
# Akta, Nicrron, Roundtable and PRISM adapters are implemented. X1 is optional.
# Keep keys on the server. Key presence alone is not a verified connection.
X1_MCP_URL=https://mcp.x1wealth.com/mcp
X1_API_KEY=
# Restrict dedicated synthetic X1 account reads to this one Second Look case ID.
X1_CASE_ID=
# Optional individual connections: stable 32-byte hex encryption key, server-only.
# Generate once with: openssl rand -hex 32. Preserve privately with database backups.
# Never derive it from a user password, presenter code or X1 API key.
X1_CONNECTION_ENCRYPTION_KEY=
NICRRON_API_KEY=
NICRRON_MODEL=nicrron/fastest
AKTA_API_KEY=
ROUNDTABLE_APP_KEY=
ROUNDTABLE_WORKER_KEY=
ROUNDTABLE_WORKER_ID=
ROUNDTABLE_PROJECT=
# Optional: absolute path to a private file containing the Roundtable variables.
# Keep credentials server-side. The app never needs your personal reporting key.
# ROUNDTABLE_ENV_FILE=
PRISM_TRACE_KEY=
PRISM_PROJECT_ID=

# Hosted synthetic demo only. Strong generated code, exact HTTPS origin,
# and an absolute persistent SQLite path outside the release directory.
# NODE_ENV=production
# PORT=3187
# DEMO_ORIGIN=
# DEMO_ACCESS_CODE=
# DEMO_DATABASE=

# Optional browser consent for individual X1 connections on secondlook.ac.
# Client ID identifies Second Look, not an investor. Public PKCE client: no client secret needed.
X1_OAUTH_CLIENT_ID=
